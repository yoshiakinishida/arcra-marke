# .env.example をコピーして .env を作り、必要な項目だけ書き換えてください
#   cp .env.example .env

# 要約の間隔（分）
SUMMARY_INTERVAL_MIN=10

# 使うモデル（haiku / sonnet / opus）。利用枠を節約したい場合は SUMMARY_MODEL=haiku
SUMMARY_MODEL=sonnet
MINUTES_MODEL=sonnet
PROPOSAL_MODEL=opus

# 自社名（提案書に反映）
MY_COMPANY=

# Google ドライブ for デスクトップの同期フォルダ。設定すると提案スライドを自動でここにコピーします
# 例: DRIVE_DIR=~/Library/CloudStorage/GoogleDrive-you@example.com/マイドライブ/商談提案
DRIVE_DIR=
